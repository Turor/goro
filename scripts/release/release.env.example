# Build-host release config for scripts/release/build-release.sh. Copy to
# /etc/goro-release/release.env on the build host (root-owned, mode 0644: the
# unprivileged build user reads it). Never commit the real file. The values are
# linked into every release binary; existing installs keep updating only if
# update_catalog_url and release_url_prefix match what they already use.
update_catalog_url = https://updates.example.invalid/client/goro/main/latest
release_url_prefix = https://objects.example.invalid/releases/goro/main/
# Optional: the asset server players stream client data from.
data_remote_url = https://assets.example.invalid/client/
