# Controller-side publisher config for the PINNED poll-and-publish.sh and
# publish-goro-main-channel.sh. Copy to ~/Work/goro-release-publisher/publish.env
# (or set GORO_PUBLISH_CONFIG). Never commit the real file.
build_host = root@build.example.invalid
garage_host = root@objects.example.invalid
# Extra ssh options for the Garage host, e.g. a jump host. May be empty.
ssh_extra = -J root@jump.example.invalid
